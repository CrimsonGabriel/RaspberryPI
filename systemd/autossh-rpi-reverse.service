[Unit]
Description=Reverse SSH tunnel RPi → VPS (22022 -> localhost:22)
After=network-online.target ssh.service
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=20

[Service]
User=piotr
Environment="AUTOSSH_GATETIME=0"

# Uwaga: bash, nie /bin/sh (dash)
ExecStartPre=/usr/bin/bash -lc 'for i in {1..30}; do </dev/tcp/127.0.0.1/22 && exit 0; sleep 1; done; exit 1'

ExecStart=/usr/bin/autossh -M 0 -N \
  -o "BatchMode=yes" \
  -o "StrictHostKeyChecking=yes" \
  -o "UserKnownHostsFile=/home/piotr/.ssh/known_hosts" \
  -o "ServerAliveInterval=15" -o "ServerAliveCountMax=3" \
  -o "ExitOnForwardFailure=yes" \
  -i /home/piotr/.ssh/id_ed25519 \
  -R 0.0.0.0:22022:localhost:22 \
  rpi-tunnel@51.195.107.80

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
